{
	"name": "@anvilkit/studio",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:watch": "vitest",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"publint": "turbo run publint",
		"check:all": "node scripts/check-banned-identifiers.mjs --advisory && turbo run check:all --concurrency=4",
		"check:banned-identifiers": "node scripts/check-banned-identifiers.mjs",
		"check:ledger": "node scripts/check-ledger-coverage.mjs",
		"check:push": "turbo run check:all --concurrency=4 --filter=\"[${ANVILKIT_CHECK_BASE:-origin/main}]\"",
		"gate:quick": "pnpm typecheck && pnpm lint && pnpm test",
		"gate:full": "pnpm typecheck && pnpm lint && pnpm madge && pnpm test && pnpm build && pnpm publint && pnpm check:all",
		"check:puck-imports": "node scripts/check-puck-imports.mjs",
		"check:submodules": "node scripts/check-submodule-contracts.mjs",
		"size": "turbo run size",
		"madge": "madge --circular --extensions ts,tsx packages/",
		"docs:dev": "turbo run docs:dev",
		"docs:build": "turbo run docs:build",
		"prepare": "git config core.hooksPath .githooks || true",
		"doctor": "npx react-doctor@latest"
	},
	"devDependencies": {
		"@anvilkit/bento-grid": "workspace:*",
		"@anvilkit/blog-list": "workspace:*",
		"@anvilkit/button": "workspace:*",
		"@anvilkit/canvas-core": "workspace:*",
		"@anvilkit/canvas-editor": "workspace:*",
		"@anvilkit/core": "workspace:*",
		"@anvilkit/helps": "workspace:*",
		"@anvilkit/hero": "workspace:*",
		"@anvilkit/input": "workspace:*",
		"@anvilkit/ir": "workspace:*",
		"@anvilkit/logo-clouds": "workspace:*",
		"@anvilkit/navbar": "workspace:*",
		"@anvilkit/plugin-ai-copilot": "workspace:*",
		"@anvilkit/plugin-collab-yjs": "workspace:*",
		"@anvilkit/plugin-export-html": "workspace:*",
		"@anvilkit/plugin-version-history": "workspace:*",
		"@anvilkit/pricing-minimal": "workspace:*",
		"@anvilkit/section": "workspace:*",
		"@anvilkit/statistics": "workspace:*",
		"@biomejs/biome": "^2.5.8",
		"@changesets/cli": "^3.0.0",
		"@puckeditor/core": "^0.23.0",
		"@rsbuild/plugin-react": "^2.1.0",
		"@rslib/core": "^0.23.2",
		"@size-limit/preset-small-lib": "^13.0.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^30.0.1",
		"madge": "^8.0.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"publint": "^0.3.23",
		"react": "^19.2.8",
		"react-doctor": "^0.9.12",
		"react-dom": "^19.2.8",
		"size-limit": "^13.0.3",
		"tsx": "^4.23.11",
		"turbo": "^2.10.10",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.10",
		"yjs": "^13.6.32",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.13"
	}
}
